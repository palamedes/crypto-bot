#!/usr/bin/env bash
# Start the Crypto Bot simulator and open it in your browser. Ctrl+C stops it.
#   CRYPTO_BOT_PORT=9000 ./crypto-bot   to use a different port
#   ./crypto-bot --no-browser           to start without opening a browser
set -euo pipefail
cd "$(dirname "$0")"

PORT="${CRYPTO_BOT_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
VENV=.venv
OPEN_BROWSER=1
[ "${1:-}" = "--no-browser" ] && OPEN_BROWSER=0

open_url() {
  [ "$OPEN_BROWSER" = 1 ] || return 0
  if command -v open >/dev/null; then open "$1"; elif command -v xdg-open >/dev/null; then xdg-open "$1"; fi
}

if curl -fs "$URL/api/config" >/dev/null 2>&1; then
  echo "Crypto Bot is already running at $URL"
  open_url "$URL"
  exit 0
fi

# Build the Python environment on first run, and again whenever requirements.txt changes.
if [ ! -x "$VENV/bin/python" ]; then
  echo "Setting up the Python environment (first run only)…"
  python3 -m venv "$VENV"
fi
REQ_SHA=$(shasum requirements.txt | cut -d' ' -f1)
if [ "$(cat "$VENV/.requirements.sha" 2>/dev/null)" != "$REQ_SHA" ]; then
  echo "Installing dependencies…"
  "$VENV/bin/pip" install --quiet --upgrade pip
  "$VENV/bin/pip" install --quiet -r requirements.txt
  echo "$REQ_SHA" > "$VENV/.requirements.sha"
fi

# Open the browser as soon as the server answers.
(
  for _ in $(seq 1 60); do
    if curl -fs "$URL/api/config" >/dev/null 2>&1; then open_url "$URL"; exit 0; fi
    sleep 0.5
  done
  echo "The server didn't come up after 30s; see the output above." >&2
) &

echo "Crypto Bot running at $URL  (Ctrl+C to stop)"
exec "$VENV/bin/python" -m uvicorn app.main:app --host 127.0.0.1 --port "$PORT" --log-level warning --timeout-graceful-shutdown 1
